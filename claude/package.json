{
  "name": "claudemcp-browser",
  "version": "2.2.0",
  "description": "Claude Code MCP browser server — Playwright browser automation over stdio / Streamable HTTP",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio",
    "dev": "tsx watch src/server.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop claudemcp-browser",
    "pm2:restart": "pm2 restart claudemcp-browser",
    "pm2:logs": "pm2 logs claudemcp-browser",
    "test:smoke": "node test/smoke-browser.mjs headless",
    "test:smoke:headed": "node test/smoke-browser.mjs headed",
    "test:cancel": "node test/cancel-probe.mjs",
    "bench:extract": "node test/extract-bench.mjs",
    "bench:batch": "node test/batch-bench.mjs",
    "test:crash": "node test/crash-recovery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/core": "^2.1.0",
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "^0.19.4",
    "express": "^5.2.1",
    "jsdom": "30.0.1",
    "patchright": "^1.63.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
