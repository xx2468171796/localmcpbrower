{
  "name": "claudemcp-browser",
  "version": "2.0.0",
  "description": "Claude Code MCP browser server — Playwright browser automation over stdio / Streamable HTTP",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio",
    "dev": "tsx watch src/server.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop claudemcp-browser",
    "pm2:restart": "pm2 restart claudemcp-browser",
    "pm2:logs": "pm2 logs claudemcp-browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "^0.18.1",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "patchright": "^1.60.2",
    "turndown": "^7.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.12.4",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
