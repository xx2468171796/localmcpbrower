# ============================================================
# Claude Code 数据库 MCP - 配置文件
# ============================================================
# 支持 PostgreSQL 与 MySQL。
# stdio 原生模式与 HTTP / PM2 模式均会读取此文件。

# 默认数据库 (启动时自动连接)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# ============================================================
# 预设数据库列表 (可选，通过别名快速切换)
# 格式: DB_别名_字段=值
# ============================================================

# 示例: 生产环境
# DB_PROD_TYPE=postgresql
# DB_PROD_HOST=prod.example.com
# DB_PROD_PORT=5432
# DB_PROD_NAME=production
# DB_PROD_USER=admin
# DB_PROD_PASSWORD=secret
# DB_PROD_SSL=true

# ============================================================
# 服务配置
# ============================================================
# HTTP 模式端口 (PM2 模式由 ecosystem.config.cjs 覆盖为 3214)
PORT=3214
