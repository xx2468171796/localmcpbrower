# ============================================================
# Claude Code 数据库 MCP - 配置文件
# ============================================================
# 支持 PostgreSQL 与 MySQL。
# stdio 原生模式与 HTTP / PM2 模式均会读取此文件。

# 默认数据库 (启动时自动连接)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# ============================================================
# 预设数据库列表 (可选，通过别名快速切换)
# 格式: DB_别名_字段=值
# ============================================================

# 示例: 生产环境
# DB_PROD_TYPE=postgresql
# DB_PROD_HOST=prod.example.com
# DB_PROD_PORT=5432
# DB_PROD_NAME=production
# DB_PROD_USER=admin
# DB_PROD_PASSWORD=secret
# DB_PROD_SSL=true

# ============================================================
# 服务配置
# ============================================================
# HTTP 模式端口 (PM2 模式由 ecosystem.config.cjs 覆盖为 3214)
PORT=3214

# ------------------------------------------------------------
# 连接池 (stdio / HTTP 两种模式都生效)
# ------------------------------------------------------------
# DB_POOL_IDLE_MS —— 连接池「无人使用」后保留多久才关闭，单位毫秒。
#   默认: stdio = 0（立刻关，与改造前 disconnect 即关池的行为一致）
#         HTTP  = 300000（5 分钟；常驻服务保留一段空闲期，避免来回切库反复重建池）
#   <=0 表示引用归零立刻关池。回收由 60 秒一次的巡检触发，所以实际关闭时刻
#   最多比设定值晚一个巡检周期。填非数字会回落默认值。
# DB_POOL_IDLE_MS=300000
#
# DB_POOL_MAX —— 单个连接池的最大连接数（pg: max / mysql: connectionLimit）。
#   默认 10。注意这是「每个库一个池」的上限，不是全服务总量。
#   填 <1 或非数字会回落 10（DB_POOL_MAX=0 等于把库关掉，故不允许）。
# DB_POOL_MAX=10

# ------------------------------------------------------------
# HTTP 服务 / 会话 (仅 HTTP 模式；stdio 模式忽略)
# ------------------------------------------------------------
# MCP_SESSION_TTL_MS —— 会话空闲多久算过期，单位毫秒，默认 1800000（30 分钟）。
#   过期后该会话占的连接池引用会被释放；客户端再拿旧的 mcp-session-id 发请求
#   一律返回 404，必须重新 initialize（绝不会静默降级到共享的库指针）。
#   清理巡检周期 = TTL/2，上限 5 分钟、下限 1 秒，所以调小它能立刻看到效果。
# MCP_SESSION_TTL_MS=1800000
#
# HOST —— 监听地址，默认 127.0.0.1。数据库端点等于一条到生产库的通道，
#   改成 0.0.0.0 / 具体网卡地址时**必须**同时设置 MCP_AUTH_TOKEN，否则拒绝启动。
# HOST=127.0.0.1
#
# MCP_AUTH_TOKEN —— 设置后要求客户端带 Authorization: Bearer <token>；不设 = 不校验（仅回环时可接受）。
# MCP_AUTH_TOKEN=
#
# MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS —— 逗号分隔，追加到 Host / Origin 白名单。
#   跨机访问时必须把客户端 URL 里实际用的 host:port 填进 MCP_ALLOWED_HOSTS，否则一律 403。
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
