# ============================================================
# Claude Code 浏览器 MCP - 配置文件
# ============================================================
# 说明: 仅 HTTP / PM2 模式需要此文件。
#       stdio 原生模式由 Claude Code 直接拉起进程，无需端口配置。
#       PM2 启动时端口由 ecosystem*.cjs 覆盖 (有头 3213 / 无头 3215)。

# 服务端口 (HTTP 模式直接 node 启动时使用)
PORT=3213

# 浏览器模式 (true=无头, false=可视化)
HEADLESS=false

# 用户数据目录
USER_DATA_DIR=storage/user_data

# 视口尺寸 (默认 1920x1080 Full HD)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# 心跳间隔 (毫秒)
HEARTBEAT_INTERVAL=30000

# Chrome DevTools (true=自动打开DevTools, false=关闭)
# 启用后会自动打开 DevTools 并开启远程调试端口 9222
DEVTOOLS=false

# 操作延迟 (毫秒, 0=最快速度)
# 设为 0 以获得最佳性能
SLOW_MO=0
