# 工位 %i 的浏览器 MCP(托管模式,有头,画在本工位的虚拟屏上)。
# 代码:所有工位共用一份只读检出 /opt/ai-desk/browser-mcp(root 所有,install.sh 构建);Chromium 在 /opt/ai-desk/ms-playwright。
# 每工位不同的值(DESK_ID、HOST/PORT、DISPLAY、目录、MCP_AUTH_TOKEN、ADMIN_TOKEN、可选 BAOLEI_MCP_*)在 env 文件里。
# 不设 DEVTOOLS_PORT:调试端口在本机回环上没有鉴权,别的工位用户能直接接管这个浏览器。
[Unit]
Description=AI desk %i - browser MCP (managed, headed)
PartOf=desk@%i.target
After=desk-wm@%i.service
Requires=desk-xvfb@%i.service

[Service]
User=desk-%i
Group=desk-%i
WorkingDirectory=/opt/ai-desk/browser-mcp/claude
Environment=NODE_ENV=production
Environment=HEADLESS=false
Environment=VIEWPORT_WIDTH=1920
Environment=VIEWPORT_HEIGHT=1080
Environment=KILL_PORT_ON_START=0
Environment=PIPE_DISABLE=1
Environment=IDLE_CLOSE_MIN=0
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ai-desk/ms-playwright
EnvironmentFile=/etc/ai-desk/desks/%i.env
ExecStart=/usr/local/bin/node dist/server.js
Restart=always
RestartSec=3
MemoryMax=3G
TasksMax=2048

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/desk-%i
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
