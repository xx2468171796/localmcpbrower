# 工位端口防火墙(只加载自己的表 inet ai_desk,不动别的规则)。规则文件 /etc/ai-desk/nftables.nft。
[Unit]
Description=AI desk firewall (desk ports only from Hermes host)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/ai-desk/nftables.nft
ExecReload=/usr/sbin/nft -f /etc/ai-desk/nftables.nft
ExecStop=/usr/sbin/nft delete table inet ai_desk

[Install]
WantedBy=sysinit.target
