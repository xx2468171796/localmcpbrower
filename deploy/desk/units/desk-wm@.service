# 工位 %i 的窗口管理器(openbox)。
[Unit]
Description=AI desk %i - openbox window manager
PartOf=desk@%i.target
After=desk-xvfb@%i.service
Requires=desk-xvfb@%i.service

[Service]
User=desk-%i
Group=desk-%i
EnvironmentFile=/etc/ai-desk/desks/%i.env
# 只要显示号 / Xauthority 这些非密钥项;密钥一律去掉
UnsetEnvironment=MCP_AUTH_TOKEN ADMIN_TOKEN SELKIES_BASIC_AUTH_PASSWORD SELKIES_BASIC_AUTH_VIEWONLY_PASSWORD BAOLEI_MCP_URL BAOLEI_MCP_TOKEN
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do timeout 2 xdpyinfo >/dev/null 2>&1 && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/bin/openbox --config-file /etc/xdg/openbox/ai-desk-rc.xml
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/desk-%i
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
IPAddressDeny=any
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
SystemCallArchitectures=native
