# 工位 %i 的窗口管理器(openbox)。
[Unit]
Description=AI desk %i - openbox window manager
PartOf=desk@%i.target
After=desk-xvfb@%i.service
Requires=desk-xvfb@%i.service

[Service]
User=desk-%i
Group=desk-%i
EnvironmentFile=/etc/ai-desk/desks/%i.env
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do xdpyinfo >/dev/null 2>&1 && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/desk-%i
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
