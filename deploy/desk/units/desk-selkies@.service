# 工位 %i 的远程画面(Selkies,H.264 over WebSocket,HTTPS 自签证书在 ~/.local/state/selkies/,每工位一份)。
# 端口 SELKIES_PORT、主密码 SELKIES_BASIC_AUTH_PASSWORD、只看密码 SELKIES_BASIC_AUTH_VIEWONLY_PASSWORD
# 都由 Selkies 直接从环境变量读 —— 不放命令行(命令行别的用户 ps 看得见)。
# 画质参数与第 0 期单工位 desk-selkies 一致。
[Unit]
Description=AI desk %i - Selkies streaming (https)
PartOf=desk@%i.target
After=desk-wm@%i.service
Requires=desk-xvfb@%i.service

[Service]
User=desk-%i
Group=desk-%i
EnvironmentFile=/etc/ai-desk/desks/%i.env
Environment=XDG_RUNTIME_DIR=/run/desk-%i
RuntimeDirectory=desk-%i
RuntimeDirectoryMode=0700
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do xdpyinfo >/dev/null 2>&1 && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/bin/selkies --addr=0.0.0.0 --enable-https=true --enable-resize=false --encoder=h264enc --framerate=60,30-60 --video-crf=20,12-22 --video-fullcolor=true --use-paint-over-quality=true --video-paintover-crf=12,5-20 --audio-enabled=false --microphone-enabled=false --gamepad-enabled=false --basic-auth-user=admin
Restart=always
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/desk-%i
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
