# 工位 %i 的空闲壁纸(一次性)。别并进 desk-wm 的 ExecStartPost:失败会拖挂窗口管理器。
[Unit]
Description=AI desk %i - idle wallpaper
PartOf=desk@%i.target
After=desk-wm@%i.service
Requires=desk-xvfb@%i.service

[Service]
Type=oneshot
User=desk-%i
Group=desk-%i
EnvironmentFile=/etc/ai-desk/desks/%i.env
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/feh --no-fehbg --bg-fill /opt/ai-desk/idle.png

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/desk-%i
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
