#!/bin/bash
# ============================================================
# mcp - 本地 MCP 服务总管理命令
# ============================================================
#
# 描述: 一站式管理所有本地 MCP 服务（浏览器 + 数据库）
#       这是 mcp-browser 和 mcp-database 的统一入口
#
# 可用服务:
#   浏览器 MCP - Playwright 浏览器自动化 (22 个工具)
#     Cursor:   http://localhost:3211/mcp
#     Windsurf: http://localhost:3213/mcp
#
#   数据库 MCP - PostgreSQL/MySQL 操作 (15 个工具)
#     Cursor:   http://localhost:3212/mcp
#     Windsurf: http://localhost:3214/mcp
#
# 用法:
#   mcp start [cursor|windsurf]    # 启动所有 MCP 服务
#   mcp stop [cursor|windsurf]     # 停止所有 MCP 服务
#   mcp restart [cursor|windsurf]  # 重启所有 MCP 服务
#   mcp status                     # 查看所有服务状态
#   mcp health                     # 健康检查所有服务
#   mcp logs                       # 查看所有日志
#   mcp info                       # 显示完整服务信息
#   mcp install [cursor|windsurf]  # 一键安装
#   mcp diagnose [cursor|windsurf] # 环境诊断
#
# 示例:
#   mcp start cursor     # 启动 Cursor 版全部 MCP 服务
#   mcp health           # 检查所有服务健康状态
#   mcp stop             # 停止所有 MCP 服务
#
# AI 调用示例:
#   # 启动服务后，AI 可通过 HTTP 调用 MCP 工具:
#   curl -X POST http://localhost:3211/mcp \
#     -H "Content-Type: application/json" \
#     -d '{"jsonrpc":"2.0","method":"tools/call","params":{"name":"navigate","arguments":{"url":"https://example.com"}},"id":1}'
#
# 依赖: Node.js >= 18, PM2, Playwright
# 安装目录: ~/code/crmall/localmcpbrower/
# ============================================================

MCP_BASE="$HOME/code/crmall/localmcpbrower"

show_help() {
    echo "mcp - 本地 MCP 服务总管理"
    echo ""
    echo "用法: mcp <command> [cursor|windsurf]"
    echo ""
    echo "命令:"
    echo "  start    [cursor|windsurf]  启动所有 MCP 服务 (浏览器+数据库)"
    echo "  stop     [cursor|windsurf]  停止所有 MCP 服务"
    echo "  restart  [cursor|windsurf]  重启所有 MCP 服务"
    echo "  status                      查看 PM2 进程状态"
    echo "  health   [cursor|windsurf]  HTTP 健康检查"
    echo "  logs     [cursor|windsurf]  查看最近日志"
    echo "  install  [cursor|windsurf]  一键安装 (npm install + build)"
    echo "  diagnose [cursor|windsurf]  环境诊断"
    echo "  info                        显示完整服务信息"
    echo "  help                        显示此帮助"
    echo ""
    echo "子命令 (直接管理单个服务):"
    echo "  mcp-browser  <command>      管理浏览器 MCP"
    echo "  mcp-database <command>      管理数据库 MCP"
    echo ""
    echo "端口分配:"
    echo "  Cursor  - Browser: 3211, Database: 3212"
    echo "  Windsurf - Browser: 3213, Database: 3214"
}

do_start() {
    local target="$1"
    echo "========================================"
    echo "  Starting MCP Services..."
    echo "========================================"
    mcp-browser start "$target"
    echo ""
    mcp-database start "$target"
    echo ""
    echo "========================================"
    sleep 3
    do_health "$target"
}

do_stop() {
    local target="$1"
    echo "========================================"
    echo "  Stopping MCP Services..."
    echo "========================================"
    mcp-browser stop "$target"
    mcp-database stop "$target"
    echo "========================================"
    echo "All services stopped."
}

do_restart() {
    local target="$1"
    echo "========================================"
    echo "  Restarting MCP Services..."
    echo "========================================"
    mcp-browser restart "$target"
    echo ""
    mcp-database restart "$target"
    echo ""
    echo "========================================"
    sleep 3
    do_health "$target"
}

do_status() {
    pm2 status
}

do_health() {
    local target="$1"
    echo "=== MCP Health Check ==="
    echo ""
    echo "[Browser MCP]"
    mcp-browser health "$target"
    echo ""
    echo "[Database MCP]"
    mcp-database health "$target"
}

do_logs() {
    local target="$1"
    mcp-browser logs "$target"
    echo ""
    mcp-database logs "$target"
}

do_install() {
    local target="${1:-cursor}"
    if [ "$target" = "cursor" ] || [ -z "$target" ]; then
        echo "=== Installing Cursor Mac MCP ==="
        cd "$MCP_BASE/cursor-mac" && bash install-all.sh
    fi
    if [ "$target" = "windsurf" ] || [ -z "$target" ]; then
        echo "=== Installing Windsurf Mac MCP ==="
        cd "$MCP_BASE/windsurf-mac" && bash install-all.sh
    fi
}

do_diagnose() {
    local target="${1:-cursor}"
    if [ "$target" = "cursor" ]; then
        cd "$MCP_BASE/cursor-mac" && bash diagnose.sh
    elif [ "$target" = "windsurf" ]; then
        cd "$MCP_BASE/windsurf-mac" && bash diagnose.sh
    fi
}

do_info() {
    echo "============================================================"
    echo "  Local MCP Services - 本地 MCP 服务总览"
    echo "============================================================"
    echo ""
    echo "  ┌─────────────┬──────────┬──────┬─────────────────────────────┐"
    echo "  │ 服务        │ IDE      │ 端口 │ MCP 地址                    │"
    echo "  ├─────────────┼──────────┼──────┼─────────────────────────────┤"
    echo "  │ Browser MCP │ Cursor   │ 3211 │ http://localhost:3211/mcp   │"
    echo "  │ Browser MCP │ Windsurf │ 3213 │ http://localhost:3213/mcp   │"
    echo "  │ Database MCP│ Cursor   │ 3212 │ http://localhost:3212/mcp   │"
    echo "  │ Database MCP│ Windsurf │ 3214 │ http://localhost:3214/mcp   │"
    echo "  └─────────────┴──────────┴──────┴─────────────────────────────┘"
    echo ""
    echo "  安装目录: $MCP_BASE"
    echo ""
    echo "  Cursor 配置:   ~/.cursor/mcp.json"
    echo "  Windsurf 配置: ~/.codeium/windsurf/mcp_config.json"
    echo ""
    echo "  全局命令: mcp, mcp-browser, mcp-database"
    echo "============================================================"
}

case "${1:-help}" in
    start)    do_start "$2" ;;
    stop)     do_stop "$2" ;;
    restart)  do_restart "$2" ;;
    status)   do_status ;;
    health)   do_health "$2" ;;
    logs)     do_logs "$2" ;;
    install)  do_install "$2" ;;
    diagnose) do_diagnose "$2" ;;
    info)     do_info ;;
    help|--help|-h) show_help ;;
    *) echo "Unknown command: $1"; show_help; exit 1 ;;
esac
