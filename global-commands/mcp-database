#!/bin/bash
# ============================================================
# mcp-database - 本地 MCP 数据库服务管理命令
# ============================================================
#
# 描述: 管理本地数据库 MCP 服务（启动/停止/重启/状态/日志）
#       提供 15 个数据库工具，支持 PostgreSQL 和 MySQL
#       支持通过命令行直接配置数据库连接（无需手动编辑文件）
#
# 服务信息:
#   - Cursor 版: 端口 3212, MCP 地址 http://localhost:3212/mcp
#   - Windsurf 版: 端口 3214, MCP 地址 http://localhost:3214/mcp
#
# 用法:
#   mcp-database start [cursor|windsurf]     # 启动数据库 MCP 服务
#   mcp-database stop [cursor|windsurf]      # 停止数据库 MCP 服务
#   mcp-database restart [cursor|windsurf]   # 重启数据库 MCP 服务
#   mcp-database status [cursor|windsurf]    # 查看服务状态
#   mcp-database logs [cursor|windsurf]      # 查看最近日志
#   mcp-database health [cursor|windsurf]    # 健康检查
#   mcp-database info                        # 显示服务配置信息
#
# 数据库配置命令 (AI 可直接调用):
#   mcp-database set <ide> --type <postgresql|mysql> --host <host> --port <port> --name <dbname> --user <user> --password <password> [--ssl true|false]
#   mcp-database show [cursor|windsurf]      # 查看当前数据库配置
#   mcp-database add-preset <ide> <alias> --type <type> --host <host> --port <port> --name <dbname> --user <user> --password <password> [--ssl true|false]
#   mcp-database remove-preset <ide> <alias> # 删除预设数据库
#   mcp-database list-presets [cursor|windsurf] # 列出所有预设
#   mcp-database use-preset <ide> <alias>    # 将预设设为默认连接
#   mcp-database test [cursor|windsurf]      # 测试数据库连接
#
# 示例 (AI 直接执行):
#   # 配置 Cursor 版默认数据库为 PostgreSQL
#   mcp-database set cursor --type postgresql --host 127.0.0.1 --port 5432 --name mydb --user postgres --password 123456
#
#   # 配置 Cursor 版默认数据库为 MySQL
#   mcp-database set cursor --type mysql --host 127.0.0.1 --port 3306 --name shop_db --user root --password root123
#
#   # 添加一个预设数据库（别名 PROD），后续可通过 MCP 的 switch_db 工具切换
#   mcp-database add-preset cursor PROD --type postgresql --host prod.example.com --port 5432 --name production --user admin --password secret --ssl true
#
#   # 配置完成后启动服务（会自动连接默认数据库）
#   mcp-database restart cursor
#
#   # 查看当前配置
#   mcp-database show cursor
#
#   # 一步到位: 配置 + 启动
#   mcp-database set cursor --type postgresql --host 127.0.0.1 --port 5432 --name mydb --user postgres --password 123456 && mcp-database restart cursor
#
# 依赖: Node.js >= 18, PM2
# 安装目录: ~/code/crmall/localmcpbrower/
# ============================================================

MCP_BASE="$HOME/code/crmall/localmcpbrower"
CURSOR_DIR="$MCP_BASE/cursor-mac/mcp-database"
WINDSURF_DIR="$MCP_BASE/windsurf-mac/mcp-database"

CURSOR_NAME="cursor-mcp-database"
WINDSURF_NAME="windsurf-mcp-database"
CURSOR_PORT=3212
WINDSURF_PORT=3214

# 根据 ide 名称获取 .env 文件路径
get_env_file() {
    local ide="$1"
    if [ "$ide" = "cursor" ]; then
        echo "$CURSOR_DIR/.env"
    elif [ "$ide" = "windsurf" ]; then
        echo "$WINDSURF_DIR/.env"
    else
        echo ""
    fi
}

# 确保 .env 文件存在
ensure_env_file() {
    local envfile="$1"
    local dir="$(dirname "$envfile")"
    if [ ! -f "$envfile" ]; then
        if [ -f "$dir/.env.example" ]; then
            cp "$dir/.env.example" "$envfile"
        else
            # 创建最小 .env
            cat > "$envfile" << 'EOF'
# MCP Database Bridge 数据库配置文件
# 由 mcp-database 命令自动生成

# 默认数据库
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# 服务端口
EOF
            # 根据 ide 写入端口
            if echo "$envfile" | grep -q "cursor"; then
                echo "PORT=$CURSOR_PORT" >> "$envfile"
            else
                echo "PORT=$WINDSURF_PORT" >> "$envfile"
            fi
        fi
    fi
}

# 在 .env 文件中设置一个键值对（存在则替换，不存在则追加）
set_env_var() {
    local envfile="$1"
    local key="$2"
    local value="$3"
    if grep -q "^${key}=" "$envfile" 2>/dev/null; then
        # macOS sed 需要 -i ''
        sed -i '' "s|^${key}=.*|${key}=${value}|" "$envfile"
    else
        echo "${key}=${value}" >> "$envfile"
    fi
}

# 删除 .env 文件中的键
remove_env_var() {
    local envfile="$1"
    local key="$2"
    sed -i '' "/^${key}=/d" "$envfile"
}

show_help() {
    echo "mcp-database - 本地 MCP 数据库服务管理"
    echo ""
    echo "用法: mcp-database <command> [options]"
    echo ""
    echo "服务管理:"
    echo "  start   [cursor|windsurf]  启动服务 (默认: 全部)"
    echo "  stop    [cursor|windsurf]  停止服务"
    echo "  restart [cursor|windsurf]  重启服务"
    echo "  status  [cursor|windsurf]  查看 PM2 状态"
    echo "  logs    [cursor|windsurf]  查看最近 50 行日志"
    echo "  health  [cursor|windsurf]  HTTP 健康检查"
    echo "  info                       显示服务配置信息"
    echo ""
    echo "数据库配置 (AI 可直接调用):"
    echo "  set <ide> --type <type> --host <host> --port <port> --name <db> --user <user> --password <pwd> [--ssl true|false]"
    echo "                             写入默认数据库配置"
    echo "  show [cursor|windsurf]     查看当前数据库配置"
    echo "  test [cursor|windsurf]     测试数据库连接"
    echo "  add-preset <ide> <alias> --type ... --host ... --port ... --name ... --user ... --password ... [--ssl ...]"
    echo "                             添加预设数据库 (可通过 switch_db 切换)"
    echo "  remove-preset <ide> <alias>  删除预设数据库"
    echo "  list-presets [cursor|windsurf] 列出所有预设"
    echo "  use-preset <ide> <alias>   将预设设为默认连接"
    echo ""
    echo "示例:"
    echo "  mcp-database set cursor --type postgresql --host 127.0.0.1 --port 5432 --name mydb --user postgres --password 123456"
    echo "  mcp-database set cursor --type mysql --host 127.0.0.1 --port 3306 --name shop --user root --password root123"
    echo "  mcp-database show cursor"
    echo "  mcp-database restart cursor"
    echo ""
    echo "MCP 端点:"
    echo "  Cursor:   http://localhost:$CURSOR_PORT/mcp"
    echo "  Windsurf: http://localhost:$WINDSURF_PORT/mcp"
}

# ============================================================
# set - 配置默认数据库连接
# ============================================================
do_set() {
    local ide="$1"; shift
    if [ -z "$ide" ] || { [ "$ide" != "cursor" ] && [ "$ide" != "windsurf" ]; }; then
        echo "[ERROR] 请指定 IDE: mcp-database set <cursor|windsurf> --type ..."
        return 1
    fi

    local db_type="" db_host="" db_port="" db_name="" db_user="" db_password="" db_ssl="false"

    while [ $# -gt 0 ]; do
        case "$1" in
            --type)     db_type="$2"; shift 2 ;;
            --host)     db_host="$2"; shift 2 ;;
            --port)     db_port="$2"; shift 2 ;;
            --name)     db_name="$2"; shift 2 ;;
            --user)     db_user="$2"; shift 2 ;;
            --password) db_password="$2"; shift 2 ;;
            --ssl)      db_ssl="$2"; shift 2 ;;
            *) echo "[WARN] Unknown option: $1"; shift ;;
        esac
    done

    if [ -z "$db_type" ] || [ -z "$db_host" ] || [ -z "$db_port" ] || [ -z "$db_name" ] || [ -z "$db_user" ]; then
        echo "[ERROR] 缺少必要参数。必须提供: --type --host --port --name --user --password"
        echo "示例: mcp-database set cursor --type postgresql --host 127.0.0.1 --port 5432 --name mydb --user postgres --password 123456"
        return 1
    fi

    local envfile
    envfile=$(get_env_file "$ide")
    ensure_env_file "$envfile"

    set_env_var "$envfile" "DB_TYPE" "$db_type"
    set_env_var "$envfile" "DB_HOST" "$db_host"
    set_env_var "$envfile" "DB_PORT" "$db_port"
    set_env_var "$envfile" "DB_NAME" "$db_name"
    set_env_var "$envfile" "DB_USER" "$db_user"
    set_env_var "$envfile" "DB_PASSWORD" "$db_password"
    set_env_var "$envfile" "DB_SSL" "$db_ssl"

    echo "[OK] $ide 默认数据库已配置:"
    echo "  类型: $db_type"
    echo "  地址: $db_host:$db_port"
    echo "  数据库: $db_name"
    echo "  用户: $db_user"
    echo "  SSL: $db_ssl"
    echo ""
    echo "运行 'mcp-database restart $ide' 使配置生效"
}

# ============================================================
# show - 查看当前数据库配置
# ============================================================
_show_one() {
        local ide="$1"
        local envfile
        envfile=$(get_env_file "$ide")
        echo "=== $ide 数据库配置 ==="
        if [ ! -f "$envfile" ]; then
            echo "  [未配置] .env 文件不存在"
            echo "  使用 'mcp-database set $ide --type ...' 配置"
        else
            echo "  文件: $envfile"
            echo "  ---"
            # 只显示 DB_ 和 PORT 开头的配置，密码部分脱敏
            while IFS='=' read -r key value; do
                [[ "$key" =~ ^#.*$ ]] && continue
                [[ -z "$key" ]] && continue
                if [[ "$key" == *PASSWORD* ]]; then
                    if [ -n "$value" ]; then
                        echo "  $key=****"
                    else
                        echo "  $key=(empty)"
                    fi
                elif [[ "$key" == DB_* ]] || [[ "$key" == PORT ]]; then
                    echo "  $key=$value"
                fi
            done < "$envfile"
        fi
        echo ""
    }

do_show() {
    local target="${1:-cursor}"

    if [ -z "$target" ] || [ "$target" = "cursor" ]; then
        _show_one "cursor"
    fi
    if [ -z "$target" ] || [ "$target" = "windsurf" ]; then
        _show_one "windsurf"
    fi
}

# ============================================================
# add-preset - 添加预设数据库
# ============================================================
do_add_preset() {
    local ide="$1"; shift
    local alias="$1"; shift

    if [ -z "$ide" ] || [ -z "$alias" ]; then
        echo "[ERROR] 用法: mcp-database add-preset <cursor|windsurf> <ALIAS> --type ... --host ..."
        return 1
    fi

    # 别名转大写
    alias=$(echo "$alias" | tr '[:lower:]' '[:upper:]')

    local db_type="" db_host="" db_port="" db_name="" db_user="" db_password="" db_ssl="false"

    while [ $# -gt 0 ]; do
        case "$1" in
            --type)     db_type="$2"; shift 2 ;;
            --host)     db_host="$2"; shift 2 ;;
            --port)     db_port="$2"; shift 2 ;;
            --name)     db_name="$2"; shift 2 ;;
            --user)     db_user="$2"; shift 2 ;;
            --password) db_password="$2"; shift 2 ;;
            --ssl)      db_ssl="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -z "$db_type" ] || [ -z "$db_host" ] || [ -z "$db_port" ] || [ -z "$db_name" ] || [ -z "$db_user" ]; then
        echo "[ERROR] 缺少必要参数"
        return 1
    fi

    local envfile
    envfile=$(get_env_file "$ide")
    ensure_env_file "$envfile"

    set_env_var "$envfile" "DB_${alias}_TYPE" "$db_type"
    set_env_var "$envfile" "DB_${alias}_HOST" "$db_host"
    set_env_var "$envfile" "DB_${alias}_PORT" "$db_port"
    set_env_var "$envfile" "DB_${alias}_NAME" "$db_name"
    set_env_var "$envfile" "DB_${alias}_USER" "$db_user"
    set_env_var "$envfile" "DB_${alias}_PASSWORD" "$db_password"
    set_env_var "$envfile" "DB_${alias}_SSL" "$db_ssl"

    echo "[OK] 预设 '$alias' 已添加到 $ide:"
    echo "  $db_type://$db_user@$db_host:$db_port/$db_name (ssl=$db_ssl)"
    echo ""
    echo "在 MCP 中使用 switch_db 工具切换: {\"alias\": \"$alias\"}"
}

# ============================================================
# remove-preset - 删除预设数据库
# ============================================================
do_remove_preset() {
    local ide="$1"
    local alias="$2"

    if [ -z "$ide" ] || [ -z "$alias" ]; then
        echo "[ERROR] 用法: mcp-database remove-preset <cursor|windsurf> <ALIAS>"
        return 1
    fi

    alias=$(echo "$alias" | tr '[:lower:]' '[:upper:]')
    local envfile
    envfile=$(get_env_file "$ide")

    if [ ! -f "$envfile" ]; then
        echo "[ERROR] 配置文件不存在"
        return 1
    fi

    remove_env_var "$envfile" "DB_${alias}_TYPE"
    remove_env_var "$envfile" "DB_${alias}_HOST"
    remove_env_var "$envfile" "DB_${alias}_PORT"
    remove_env_var "$envfile" "DB_${alias}_NAME"
    remove_env_var "$envfile" "DB_${alias}_USER"
    remove_env_var "$envfile" "DB_${alias}_PASSWORD"
    remove_env_var "$envfile" "DB_${alias}_SSL"

    echo "[OK] 预设 '$alias' 已从 $ide 删除"
}

# ============================================================
# list-presets - 列出所有预设
# ============================================================
_list_one() {
        local ide="$1"
        local envfile
        envfile=$(get_env_file "$ide")
        echo "=== $ide 预设数据库 ==="
        if [ ! -f "$envfile" ]; then
            echo "  (无配置文件)"
            return
        fi
        local found=0
        local aliases=()
        while IFS='=' read -r key value; do
            if [[ "$key" =~ ^DB_([A-Z0-9_]+)_TYPE$ ]]; then
                local a="${BASH_REMATCH[1]}"
                # 排除默认的 DB_TYPE
                if [ "$a" != "" ]; then
                    aliases+=("$a")
                fi
            fi
        done < "$envfile"

        if [ ${#aliases[@]} -eq 0 ]; then
            echo "  (无预设)"
        else
            for a in "${aliases[@]}"; do
                local t=$(grep "^DB_${a}_TYPE=" "$envfile" | cut -d= -f2)
                local h=$(grep "^DB_${a}_HOST=" "$envfile" | cut -d= -f2)
                local p=$(grep "^DB_${a}_PORT=" "$envfile" | cut -d= -f2)
                local n=$(grep "^DB_${a}_NAME=" "$envfile" | cut -d= -f2)
                local u=$(grep "^DB_${a}_USER=" "$envfile" | cut -d= -f2)
                echo "  $a: $t://$u@$h:$p/$n"
            done
        fi
        echo ""
    }

do_list_presets() {
    local target="${1:-cursor}"

    if [ -z "$target" ] || [ "$target" = "cursor" ]; then
        _list_one "cursor"
    fi
    if [ -z "$target" ] || [ "$target" = "windsurf" ]; then
        _list_one "windsurf"
    fi
}

# ============================================================
# use-preset - 将预设设为默认连接
# ============================================================
do_use_preset() {
    local ide="$1"
    local alias="$2"

    if [ -z "$ide" ] || [ -z "$alias" ]; then
        echo "[ERROR] 用法: mcp-database use-preset <cursor|windsurf> <ALIAS>"
        return 1
    fi

    alias=$(echo "$alias" | tr '[:lower:]' '[:upper:]')
    local envfile
    envfile=$(get_env_file "$ide")

    if [ ! -f "$envfile" ]; then
        echo "[ERROR] 配置文件不存在"
        return 1
    fi

    local t=$(grep "^DB_${alias}_TYPE=" "$envfile" | cut -d= -f2)
    local h=$(grep "^DB_${alias}_HOST=" "$envfile" | cut -d= -f2)
    local p=$(grep "^DB_${alias}_PORT=" "$envfile" | cut -d= -f2)
    local n=$(grep "^DB_${alias}_NAME=" "$envfile" | cut -d= -f2)
    local u=$(grep "^DB_${alias}_USER=" "$envfile" | cut -d= -f2)
    local pw=$(grep "^DB_${alias}_PASSWORD=" "$envfile" | cut -d= -f2)
    local s=$(grep "^DB_${alias}_SSL=" "$envfile" | cut -d= -f2)

    if [ -z "$t" ]; then
        echo "[ERROR] 预设 '$alias' 不存在"
        return 1
    fi

    set_env_var "$envfile" "DB_TYPE" "$t"
    set_env_var "$envfile" "DB_HOST" "$h"
    set_env_var "$envfile" "DB_PORT" "$p"
    set_env_var "$envfile" "DB_NAME" "$n"
    set_env_var "$envfile" "DB_USER" "$u"
    set_env_var "$envfile" "DB_PASSWORD" "$pw"
    set_env_var "$envfile" "DB_SSL" "${s:-false}"

    echo "[OK] 默认数据库已切换为预设 '$alias': $t://$u@$h:$p/$n"
    echo "运行 'mcp-database restart $ide' 使配置生效"
}

# ============================================================
# test - 测试数据库连接
# ============================================================
_test_one() {
        local ide="$1"
        local port
        if [ "$ide" = "cursor" ]; then port=$CURSOR_PORT; else port=$WINDSURF_PORT; fi

        echo -n "[$ide] Testing database connection... "
        local result
        result=$(curl -s -X POST "http://localhost:$port/mcp" \
            -H "Content-Type: application/json" \
            -d '{"jsonrpc":"2.0","method":"tools/call","params":{"name":"status","arguments":{}},"id":1}' 2>/dev/null)

        if [ -z "$result" ]; then
            echo "FAILED (service not running, start it first)"
        elif echo "$result" | grep -q '"connected":true'; then
            echo "OK (connected)"
            echo "  $result" | grep -o '"host":"[^"]*"' | head -1
            echo "  $result" | grep -o '"database":"[^"]*"' | head -1
        else
            echo "NOT CONNECTED"
            echo "  Check config: mcp-database show $ide"
        fi
    }

do_test() {
    local target="${1:-cursor}"

    if [ "$target" = "cursor" ] || [ -z "$target" ]; then
        _test_one "cursor"
    fi
    if [ "$target" = "windsurf" ] || [ -z "$target" ]; then
        _test_one "windsurf"
    fi
}

# ============================================================
# 服务管理命令
# ============================================================
do_start() {
    local target="$1"
    if [ -z "$target" ] || [ "$target" = "cursor" ]; then
        echo "[Database MCP] Starting Cursor (port $CURSOR_PORT)..."
        cd "$CURSOR_DIR" && pm2 delete "$CURSOR_NAME" 2>/dev/null; pm2 start ecosystem.config.cjs
    fi
    if [ -z "$target" ] || [ "$target" = "windsurf" ]; then
        echo "[Database MCP] Starting Windsurf (port $WINDSURF_PORT)..."
        cd "$WINDSURF_DIR" && pm2 delete "$WINDSURF_NAME" 2>/dev/null; pm2 start ecosystem.config.cjs
    fi
}

do_stop() {
    local target="$1"
    if [ -z "$target" ] || [ "$target" = "cursor" ]; then
        pm2 stop "$CURSOR_NAME" 2>/dev/null; pm2 delete "$CURSOR_NAME" 2>/dev/null
        echo "[OK] $CURSOR_NAME stopped."
    fi
    if [ -z "$target" ] || [ "$target" = "windsurf" ]; then
        pm2 stop "$WINDSURF_NAME" 2>/dev/null; pm2 delete "$WINDSURF_NAME" 2>/dev/null
        echo "[OK] $WINDSURF_NAME stopped."
    fi
}

do_restart() {
    local target="$1"
    if [ -z "$target" ] || [ "$target" = "cursor" ]; then
        echo "[Database MCP] Restarting Cursor..."
        cd "$CURSOR_DIR" && pm2 restart ecosystem.config.cjs 2>/dev/null || pm2 start ecosystem.config.cjs
    fi
    if [ -z "$target" ] || [ "$target" = "windsurf" ]; then
        echo "[Database MCP] Restarting Windsurf..."
        cd "$WINDSURF_DIR" && pm2 restart ecosystem.config.cjs 2>/dev/null || pm2 start ecosystem.config.cjs
    fi
}

do_status() {
    local target="$1"
    if [ -z "$target" ]; then
        pm2 status
    elif [ "$target" = "cursor" ]; then
        pm2 describe "$CURSOR_NAME" 2>/dev/null || echo "$CURSOR_NAME not running"
    elif [ "$target" = "windsurf" ]; then
        pm2 describe "$WINDSURF_NAME" 2>/dev/null || echo "$WINDSURF_NAME not running"
    fi
}

do_logs() {
    local target="$1"
    if [ -z "$target" ] || [ "$target" = "cursor" ]; then
        echo "=== $CURSOR_NAME logs ==="
        pm2 logs "$CURSOR_NAME" --lines 50 --nostream 2>/dev/null
    fi
    if [ -z "$target" ] || [ "$target" = "windsurf" ]; then
        echo "=== $WINDSURF_NAME logs ==="
        pm2 logs "$WINDSURF_NAME" --lines 50 --nostream 2>/dev/null
    fi
}

do_health() {
    local target="$1"
    if [ -z "$target" ] || [ "$target" = "cursor" ]; then
        echo -n "[Cursor  :$CURSOR_PORT] "
        curl -s "http://localhost:$CURSOR_PORT/health" 2>/dev/null || echo "NOT RESPONDING"
        echo ""
    fi
    if [ -z "$target" ] || [ "$target" = "windsurf" ]; then
        echo -n "[Windsurf:$WINDSURF_PORT] "
        curl -s "http://localhost:$WINDSURF_PORT/health" 2>/dev/null || echo "NOT RESPONDING"
        echo ""
    fi
}

do_info() {
    echo "=== MCP Database Service Info ==="
    echo ""
    echo "Cursor 版:"
    echo "  目录: $CURSOR_DIR"
    echo "  端口: $CURSOR_PORT"
    echo "  MCP:  http://localhost:$CURSOR_PORT/mcp"
    echo "  PM2:  $CURSOR_NAME"
    echo "  配置: $CURSOR_DIR/.env"
    echo ""
    echo "Windsurf 版:"
    echo "  目录: $WINDSURF_DIR"
    echo "  端口: $WINDSURF_PORT"
    echo "  MCP:  http://localhost:$WINDSURF_PORT/mcp"
    echo "  PM2:  $WINDSURF_NAME"
    echo "  配置: $WINDSURF_DIR/.env"
    echo ""
    echo "支持数据库: PostgreSQL, MySQL"
    echo ""
    echo "可用工具 (15个):"
    echo "  connect, disconnect, status, list_presets, switch_db,"
    echo "  query, execute, list_tables, describe_table, list_databases,"
    echo "  explain_query, table_indexes, table_relations, table_stats,"
    echo "  export_csv"
}

# ============================================================
# 主入口
# ============================================================
case "${1:-help}" in
    start)          do_start "$2" ;;
    stop)           do_stop "$2" ;;
    restart)        do_restart "$2" ;;
    status)         do_status "$2" ;;
    logs)           do_logs "$2" ;;
    health)         do_health "$2" ;;
    info)           do_info ;;
    set)            shift; do_set "$@" ;;
    show)           do_show "$2" ;;
    test)           do_test "$2" ;;
    add-preset)     shift; do_add_preset "$@" ;;
    remove-preset)  do_remove_preset "$2" "$3" ;;
    list-presets)   do_list_presets "$2" ;;
    use-preset)     do_use_preset "$2" "$3" ;;
    help|--help|-h) show_help ;;
    *) echo "Unknown command: $1"; show_help; exit 1 ;;
esac
